{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": ["vite/client"],
        "noEmit": true,
        "allowJs": true
    },
    "include": ["src", ".storybook", "vite.config.ts", "eslint.config.js"]
}
